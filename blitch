<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Flowdesk — Suivi des virements</title><style>
:root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#182337;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}.layout{display:grid;grid-template-columns:238px 1fr;min-height:100vh}.side{background:#101c34;color:#c6d0e2;padding:29px 18px;display:flex;flex-direction:column;gap:25px}.logo{color:white;font-weight:800;font-size:22px;letter-spacing:-.8px;padding:0 13px}.logo span{color:#7b91ff}.side small{padding:0 13px;color:#7384a1;font-weight:700;letter-spacing:1.3px}.nav{display:flex;flex-direction:column;gap:5px}.nav button{border:0;background:transparent;color:#aebcd2;text-align:left;border-radius:11px;padding:12px 14px;font-weight:600}.nav button.active,.nav button:hover{background:#263857;color:#fff}.foot{margin-top:auto;padding:15px 13px;font-size:12px;color:#8191ad;line-height:1.7}.main{padding:32px 40px;max-width:1580px;width:100%;margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:27px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:1.2px;color:#74829a;text-transform:uppercase}h1{font-size:29px;letter-spacing:-1.1px;margin:5px 0 0}h2{font-size:18px;letter-spacing:-.4px;margin:0}p{margin:6px 0;color:#7a879c}.btn{border:0;border-radius:11px;padding:12px 16px;font-weight:700;background:#445ff1;color:white;box-shadow:0 5px 14px #4058e32a}.btn:hover{background:#344ed9}.btn.secondary{background:white;border:1px solid #e1e6ef;box-shadow:none;color:#253650}.btn.danger{background:#fff0f0;color:#c63144;box-shadow:none}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:24px}.card,.panel{background:white;border:1px solid #e7ebf2;border-radius:16px;box-shadow:0 5px 22px #24335b06}.card{padding:22px}.card .label{font-size:12px;color:#78859b;font-weight:700}.card .value{font-size:26px;letter-spacing:-1px;font-weight:800;margin:12px 0 5px;white-space:nowrap}.card .sub{font-size:12px;color:#8995a7}.card.highlight{background:#243b78;color:#fff;border-color:#243b78}.card.highlight .label,.card.highlight .sub{color:#c6d5f6}.toolbar{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:0 0 20px}.toolbar select,.toolbar input{border:1px solid #e0e5ee;border-radius:10px;background:white;padding:11px 12px;color:#33435d;max-width:100%}.toolbar input{min-width:200px}.content{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.8fr);gap:20px}.panel{padding:23px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:19px}.muted{font-size:13px;color:#8894a7}.days{display:flex;flex-direction:column;gap:11px;max-height:630px;overflow:auto}.day{border:1px solid #e8edf4;border-radius:13px;overflow:hidden}.day-top{background:#f8faff;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px}.day-top strong{font-size:14px}.day-total{font-weight:800;color:#263e81}.entry{display:flex;align-items:center;gap:11px;padding:12px 14px;border-top:1px solid #f0f2f7}.avatar{height:37px;width:37px;display:grid;place-items:center;border-radius:10px;background:#e8edff;color:#455cc6;font-weight:800;flex-shrink:0}.entry-info{flex:1;min-width:0}.entry-info b{font-size:13px}.entry-info small{display:block;color:#8c97aa;margin-top:3px}.entry-right{text-align:right}.entry-right b{font-size:14px}.pill{font-size:10px;padding:4px 7px;border-radius:7px;font-weight:800;display:inline-block;margin-top:5px}.pill.pending{color:#a2690e;background:#fff3dc}.pill.received{color:#18835c;background:#e4f8ee}.pill.delayed{color:#c34444;background:#ffe9e9}.iconbtn{border:0;background:transparent;color:#8492a8;font-size:18px;padding:5px}.calendar-controls{display:flex;gap:10px;align-items:center}.calendar-controls button{border:1px solid #e3e8f1;border-radius:8px;background:#fff;padding:5px 10px}.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.caldayname{text-align:center;color:#9aa5b7;font-size:11px;font-weight:800;padding:6px 0}.calcell{height:69px;border:1px solid #edf0f6;border-radius:10px;padding:7px 5px;text-align:left;background:#fff;display:flex;flex-direction:column;gap:5px;overflow:hidden}.calcell.other{opacity:.27}.calcell.today{border-color:#6d80f6}.calcell.selected{background:#eaf0ff;border-color:#6d80f6}.calcell b{font-size:12px}.calcell small{font-size:10px;color:#4663c9;font-weight:800;white-space:nowrap}.calcell:hover{background:#f4f6ff}.breakdown{margin-top:23px;border-top:1px solid #edf0f6;padding-top:19px}.breakdown-row{display:flex;justify-content:space-between;margin-top:11px;font-size:13px}.breakdown-row b{font-weight:800}.empty{text-align:center;padding:34px 10px;color:#96a1b2}.overlay{position:fixed;inset:0;background:#14203b88;display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.overlay.open{display:flex}.modal{background:white;border-radius:20px;width:min(660px,100%);max-height:94vh;overflow:auto;padding:26px;box-shadow:0 30px 90px #111a3740}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}label{font-size:12px;font-weight:800;color:#53617a}.field input,.field select{border:1px solid #dce3ee;border-radius:10px;padding:12px;width:100%;outline:0}.field input:focus,.field select:focus{border-color:#6275ed;box-shadow:0 0 0 3px #6a7fff20}.split{margin-top:20px;background:#f7f9fd;border-radius:13px;padding:16px}.splithead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px}.personrow{display:grid;grid-template-columns:1fr 100px 90px 28px;align-items:center;gap:8px;margin-bottom:8px}.personrow input{min-width:0;padding:9px;border:1px solid #dce3ee;border-radius:8px}.personrow output{text-align:right;font-size:12px;font-weight:800}.mini{border:1px solid #dce3ee;background:white;color:#445ff1;padding:8px 11px;border-radius:8px;font-weight:700;font-size:12px}.totalpercent{font-size:12px;font-weight:800;text-align:right;margin-top:10px}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.hint{font-size:12px;color:#8996a8;margin-top:9px}.sectiononly{display:none}.sectiononly.active{display:block}.accounts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.accountcard{padding:20px;border:1px solid #e5eaf2;border-radius:13px;background:white}.accountcard strong{display:block;margin-bottom:8px}.accountcard small{color:#8491a5}.toast{position:fixed;bottom:20px;right:20px;background:#182c52;color:white;padding:12px 17px;border-radius:10px;display:none;z-index:20;font-size:13px}.error{color:#cb3447;font-size:12px;margin-top:8px;display:none}@media(max-width:1120px){.cards{grid-template-columns:repeat(2,1fr)}.content{grid-template-columns:1fr}.main{padding:24px}}@media(max-width:700px){.layout{display:block}.side{padding:15px;gap:12px}.nav{flex-direction:row;overflow:auto}.nav button{white-space:nowrap}.side small,.foot{display:none}.main{padding:18px}.top{align-items:flex-start}h1{font-size:24px}.cards{gap:9px}.card{padding:15px}.card .value{font-size:19px}.panel{padding:15px}.accounts{grid-template-columns:1fr}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.personrow{grid-template-columns:1fr 66px 74px 24px}.modal{padding:17px}.calcell{height:60px;padding:5px 3px}.calcell small{font-size:9px}.toolbar input{min-width:0;width:100%}}
</style></head><body><div class="layout"><aside class="side"><div class="logo">flow<span>desk.</span></div><small>ESPACE DE GESTION</small><nav class="nav"><button class="active" data-view="dashboard">◫ &nbsp; Vue d'ensemble</button><button data-view="accounts">▣ &nbsp; Comptes Stripe</button><button data-view="history">≡ &nbsp; Tous les virements</button></nav><div class="foot">Suivi manuel des virements.<br>Les dates sont prévisionnelles jusqu'à confirmation.</div></aside><main class="main"><header class="top"><div><div class="eyebrow">GESTION FINANCIÈRE</div><h1 id="pagetitle">Vue d'ensemble</h1><p id="subtitle">Suivez vos entrées d'argent jour après jour.</p></div><button class="btn" id="addBtn">＋ Nouveau virement</button></header><section id="dashboard" class="sectiononly active"><div class="cards"><div class="card highlight"><div class="label">Total prévu</div><div class="value" id="total">0 €</div><div class="sub">Tous les virements enregistrés</div></div><div class="card"><div class="label">Aujourd'hui</div><div class="value" id="todayTotal">0 €</div><div class="sub" id="todayDate"></div></div><div class="card"><div class="label">À recevoir</div><div class="value" id="pending">0 €</div><div class="sub">Virements non confirmés</div></div><div class="card"><div class="label">Déjà reçu</div><div class="value" id="received">0 €</div><div class="sub">Virements marqués reçus</div></div></div><div class="toolbar"><select id="accountFilter"><option value="">Tous les comptes Stripe</option></select><select id="statusFilter"><option value="">Tous les statuts</option><option value="pending">En attente</option><option value="received">Reçu</option><option value="delayed">En retard</option></select><input type="search" id="search" placeholder="Rechercher un compte ou une note…"><button class="btn secondary" id="clearFilter">Réinitialiser</button></div><div class="content"><section class="panel"><div class="panel-head"><div><h2>Virements par jour</h2><p class="muted">Montants et comptes regroupés par date</p></div><button class="mini" id="exportBtn">↓ Export CSV</button></div><div id="days" class="days"></div></section><section class="panel"><div class="panel-head"><h2>Calendrier</h2><div class="calendar-controls"><button id="prevMonth">‹</button><b id="monthLabel" style="font-size:13px"></b><button id="nextMonth">›</button></div></div><div id="calendar" class="calendar"></div><div class="breakdown"><h2 id="selectedLabel">Détail du jour</h2><div id="selectedBreakdown"></div></div></section></div></section><section id="accounts" class="sectiononly"><div class="panel"><div class="panel-head"><h2>Mes comptes Stripe</h2><button class="btn" id="addAccountBtn">＋ Ajouter un compte</button></div><p class="muted">Les comptes sont des libellés de suivi. Aucune connexion à Stripe n'est effectuée.</p><div id="accountsList" class="accounts" style="margin-top:22px"></div></div></section><section id="history" class="sectiononly"><div class="panel"><div class="panel-head"><h2>Historique complet</h2><button class="mini" id="exportBtn2">↓ Export CSV</button></div><div id="historyList"></div></div></section></main></div>
<div class="overlay" id="modal"><div class="modal"><div class="modalhead"><h2 id="modalTitle">Nouveau virement</h2><button class="iconbtn" id="closeModal">✕</button></div><form id="entryForm"><div class="formgrid"><div class="field"><label>Compte Stripe *</label><select id="formAccount" required></select></div><div class="field"><label>Montant attendu (€) *</label><input id="formAmount" type="number" min="0.01" step="0.01" placeholder="Ex. 8500" required></div><div class="field"><label>Date prévue *</label><input id="formDate" type="date" required></div><div class="field"><label>Statut</label><select id="formStatus"><option value="pending">En attente</option><option value="received">Reçu</option><option value="delayed">En retard</option></select></div><div class="field full"><label>Note (facultatif)</label><input id="formNote" placeholder="Ex. Virement octobre"></div></div><div class="split"><div class="splithead"><div><strong>Répartition des parts</strong><div class="hint">Calculée sur le montant indiqué</div></div><button class="mini" type="button" id="addPerson">＋ Personne</button></div><div id="people"></div><div class="totalpercent" id="percentTotal">Total : 0 %</div><div class="error" id="formError"></div></div><div class="actions"><button class="btn secondary" type="button" id="cancelModal">Annuler</button><button class="btn" type="submit">Enregistrer le virement</button></div></form></div></div>
<div class="overlay" id="accountModal"><div class="modal" style="max-width:410px"><div class="modalhead"><h2>Ajouter un compte Stripe</h2><button class="iconbtn" id="closeAccount">✕</button></div><form id="accountForm"><div class="field"><label>Nom du compte *</label><input id="accountName" placeholder="Ex. Stripe Boutique 1" maxlength="70" required></div><div class="actions"><button type="button" class="btn secondary" id="cancelAccount">Annuler</button><button class="btn" type="submit">Ajouter</button></div></form></div></div><div class="toast" id="toast"></div>
<script>
(()=>{'use strict';const KEY='flowdesk_v2';const oldKey='stripe_tracker_v1';const $=s=>document.querySelector(s);const money=n=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(Number(n)||0);const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;const today=iso(new Date());const labelDate=s=>new Date(s+'T12:00:00').toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});const escape=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch(e){}if(!state||!Array.isArray(state.entries)||!Array.isArray(state.accounts))state={accounts:[],entries:[]};let editing=null,month=new Date().getMonth(),year=new Date().getFullYear(),selected=today;function save(){localStorage.setItem(KEY,JSON.stringify(state))}function notify(msg){$('#toast').textContent=msg;$('#toast').style.display='block';setTimeout(()=>$('#toast').style.display='none',2600)}function refreshAccounts(){const options=state.accounts.map(a=>`<option value="${escape(a.id)}">${escape(a.name)}</option>`).join('');$('#formAccount').innerHTML='<option value="">Choisir un compte</option>'+options;const prev=$('#accountFilter').value;$('#accountFilter').innerHTML='<option value="">Tous les comptes Stripe</option>'+options;$('#accountFilter').value=prev}function accName(id){return state.accounts.find(a=>a.id===id)?.name||'Compte supprimé'}function filtered(){const account=$('#accountFilter').value,status=$('#statusFilter').value,q=$('#search').value.trim().toLowerCase();return state.entries.filter(e=>(!account||e.account===account)&&(!status||e.status===status)&&(!q||(accName(e.account)+' '+(e.note||'')).toLowerCase().includes(q)))}function statusLabel(s){return {pending:'En attente',received:'Reçu',delayed:'En retard'}[s]||'En attente'}function entryHTML(e){return `<div class="entry"><div class="avatar">${escape(accName(e.account).slice(0,1).toUpperCase())}</div><div class="entry-info"><b>${escape(accName(e.account))}</b><small>${escape(e.note||'Répartition : '+(e.people||[]).map(p=>p.name+' '+p.pct+'%').join(' · '))}</small></div><div class="entry-right"><b>${money(e.amount)}</b><br><span class="pill ${escape(e.status)}">${statusLabel(e.status)}</span></div><button class="iconbtn" data-edit="${escape(e.id)}" title="Modifier">✎</button></div>`}function renderDays(){const entries=filtered().sort((a,b)=>a.date.localeCompare(b.date));const dates=[...new Set(entries.map(e=>e.date))];$('#days').innerHTML=dates.length?dates.map(date=>{const es=entries.filter(e=>e.date===date);return `<div class="day"><div class="day-top"><strong>${escape(labelDate(date))}${date===today?' · Aujourd’hui':''}</strong><span class="day-total">${money(es.reduce((s,e)=>s+e.amount,0))} <span class="muted">(${es.length})</span></span></div>${es.map(entryHTML).join('')}</div>`}).join(''):'<div class="empty">Aucun virement pour ces filtres.<br>Ajoute ton premier virement avec le bouton en haut.</div>'}function renderStats(){const all=filtered();$('#total').textContent=money(all.reduce((s,e)=>s+e.amount,0));$('#todayTotal').textContent=money(all.filter(e=>e.date===today).reduce((s,e)=>s+e.amount,0));$('#pending').textContent=money(all.filter(e=>e.status!=='received').reduce((s,e)=>s+e.amount,0));$('#received').textContent=money(all.filter(e=>e.status==='received').reduce((s,e)=>s+e.amount,0));$('#todayDate').textContent=labelDate(today)}function renderCalendar(){const first=new Date(year,month,1),offset=(first.getDay()+6)%7,last=new Date(year,month+1,0).getDate();$('#monthLabel').textContent=first.toLocaleDateString('fr-FR',{month:'long',year:'numeric'});const names=['L','M','M','J','V','S','D'];let html=names.map(n=>`<div class="caldayname">${n}</div>`).join('');for(let i=0;i<Math.ceil((offset+last)/7)*7;i++){const d=i-offset+1,valid=d>0&&d<=last,date=iso(new Date(year,month,d)),sum=filtered().filter(e=>e.date===date).reduce((s,e)=>s+e.amount,0);html+=`<button class="calcell ${valid?'':'other'} ${date===today?'today':''} ${date===selected?'selected':''}" data-date="${date}" ${valid?'':'disabled'}><b>${valid?d:''}</b>${sum?`<small>${new Intl.NumberFormat('fr-FR',{notation:'compact',maximumFractionDigits:1}).format(sum)} €</small>`:''}</button>`}$('#calendar').innerHTML=html;renderSelected()}function renderSelected(){const es=filtered().filter(e=>e.date===selected),sum=es.reduce((s,e)=>s+e.amount,0);$('#selectedLabel').textContent=labelDate(selected);$('#selectedBreakdown').innerHTML=`<div class="breakdown-row"><span>Total prévu</span><b>${money(sum)}</b></div><div class="breakdown-row"><span>Nombre de virements</span><b>${es.length}</b></div>`+es.map(e=>`<div class="breakdown-row"><span>${escape(accName(e.account))}</span><b>${money(e.amount)}</b></div>`).join('')+(es.length?`<div class="hint" style="margin-top:16px">Répartition des parts :</div>`+es.map(e=>`<div class="hint" style="margin-top:9px"><b>${escape(accName(e.account))}</b> — ${(e.people||[]).map(p=>escape(p.name)+' : '+money(e.amount*p.pct/100)).join(' · ')}</div>`).join(''):'<div class="hint">Aucun virement ce jour.</div>')}function renderAccountCards(){const entries=state.entries;$('#accountsList').innerHTML=state.accounts.length?state.accounts.map(a=>{const es=entries.filter(e=>e.account===a.id);return `<div class="accountcard"><strong>${escape(a.name)}</strong><small>${es.length} virement(s) · ${money(es.reduce((s,e)=>s+e.amount,0))}</small><div style="margin-top:13px"><button class="mini" data-remove-account="${escape(a.id)}">Supprimer</button></div></div>`}).join(''):'<div class="empty">Aucun compte. Ajoute un compte Stripe pour commencer.</div>'}function renderHistory(){$('#historyList').innerHTML=state.entries.length?state.entries.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(e=>`<div class="day" style="margin-bottom:10px"><div class="day-top"><strong>${escape(labelDate(e.date))}</strong><span class="day-total">${money(e.amount)}</span></div>${entryHTML(e)}<div style="padding:0 15px 12px;font-size:12px;color:#78859b">${(e.people||[]).map(p=>escape(p.name)+' : '+p.pct+' % ('+money(e.amount*p.pct/100)+')').join(' · ')}</div></div>`).join(''):'<div class="empty">Aucun virement enregistré.</div>'}function render(){refreshAccounts();renderStats();renderDays();renderCalendar();renderAccountCards();renderHistory()}function addPerson(name='',pct=0){const row=document.createElement('div');row.className='personrow';row.innerHTML=`<input class="person-name" placeholder="Nom du bénéficiaire" maxlength="70" value="${escape(name)}" aria-label="Nom"><input class="person-pct" type="number" min="0" max="100" step="0.01" value="${Number(pct)||0}" aria-label="Pourcentage"><output>0 €</output><button type="button" class="iconbtn remove-person" title="Retirer">×</button>`;$('#people').append(row);row.querySelectorAll('input').forEach(el=>el.addEventListener('input',updateSplit));row.querySelector('.remove-person').onclick=()=>{row.remove();updateSplit()};updateSplit()}function updateSplit(){const amount=Number($('#formAmount').value)||0;let sum=0;document.querySelectorAll('.personrow').forEach(r=>{const pct=Number(r.querySelector('.person-pct').value)||0;sum+=pct;r.querySelector('output').textContent=money(amount*pct/100)});$('#percentTotal').textContent=`Total : ${Number(sum.toFixed(2))} % / 100 %`;$('#percentTotal').style.color=Math.abs(sum-100)<.001?'#18835c':'#c34444'}function openEntry(id=null){editing=id;$('#entryForm').reset();$('#people').innerHTML='';$('#formError').style.display='none';$('#formDate').value=today;const e=state.entries.find(e=>e.id===id);$('#modalTitle').textContent=e?'Modifier le virement':'Nouveau virement';if(e){$('#formAccount').value=e.account;$('#formAmount').value=e.amount;$('#formDate').value=e.date;$('#formStatus').value=e.status;$('#formNote').value=e.note||'';(e.people||[]).forEach(p=>addPerson(p.name,p.pct))}else{addPerson('Moi',40);addPerson('Associé',30);addPerson('Autre bénéficiaire',30)}updateSplit();$('#modal').classList.add('open')}function closeEntry(){$('#modal').classList.remove('open')}$('#entryForm').onsubmit=ev=>{ev.preventDefault();const account=$('#formAccount').value,amount=Number($('#formAmount').value),date=$('#formDate').value,people=[...document.querySelectorAll('.personrow')].map(r=>({name:r.querySelector('.person-name').value.trim(),pct:Number(r.querySelector('.person-pct').value)}));const total=people.reduce((s,p)=>s+p.pct,0);let error='';if(!state.accounts.some(a=>a.id===account))error='Choisis un compte Stripe.';else if(!Number.isFinite(amount)||amount<=0||!date)error='Indique un montant positif et une date.';else if(!people.length||people.some(p=>!p.name||!Number.isFinite(p.pct)||p.pct<0||p.pct>100))error='Renseigne les noms et les pourcentages.';else if(Math.abs(total-100)>.001)error='La somme des parts doit faire exactement 100 %.';if(error){$('#formError').textContent=error;$('#formError').style.display='block';return}const entry={id:editing||crypto.randomUUID(),account,amount,date,status:$('#formStatus').value,note:$('#formNote').value.trim(),people};if(editing){state.entries=state.entries.map(e=>e.id===editing?entry:e)}else state.entries.push(entry);save();closeEntry();render();notify('Virement enregistré')};$('#addBtn').onclick=()=>{if(!state.accounts.length){$('#accountModal').classList.add('open');notify('Ajoute d’abord un compte Stripe')}else openEntry()};$('#closeModal').onclick=$('#cancelModal').onclick=closeEntry;$('#addPerson').onclick=()=>addPerson('',0);$('#formAmount').oninput=updateSplit;$('#days').onclick=$('#historyList').onclick=e=>{const b=e.target.closest('[data-edit]');if(b)openEntry(b.dataset.edit)};$('#prevMonth').onclick=()=>{month--;if(month<0){month=11;year--}renderCalendar()};$('#nextMonth').onclick=()=>{month++;if(month>11){month=0;year++}renderCalendar()};$('#calendar').onclick=e=>{const b=e.target.closest('[data-date]');if(b){s